# ── .env.example — local configuration template ─────────────────────────────
#
# Copy to .env and fill in. Only connection endpoints, credentials and a few
# deployment flags belong here; everything that shapes retrieval behaviour
# (budgets, caps, scoring weights, prompts) is a code default in settings.py.
# Any setting can still be overridden with its AGR_-prefixed name.
#
# The defaults line up with the open-source ai-graph-ingestion stack (its
# docker-compose exposes Neo4j, Qdrant and MongoDB on localhost), so the same
# values work for both services.

# ── LLM + embeddings (OpenAI-compatible: NVIDIA NIM, vLLM, OpenAI, ...) ──────
# NVIDIA_API_KEY is read as AGR_LLM_API_KEY. Embeddings reuse the chat endpoint
# and key unless AGR_EMBEDDING_BASE_URL / AGR_EMBEDDING_API_KEY are set.
NVIDIA_API_KEY=change-me
# AGR_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# AGR_LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b
# AGR_FAST_MODEL=                     # cheaper model for routing/ranking; empty = AGR_LLM_MODEL
# AGR_EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b
# AGR_EMBEDDING_DIMENSIONS=2048       # must match the ingested vectors
# AGR_EMBEDDING_INPUT_TYPE=query      # ingestion embeds with "passage"
# Local vLLM example (no key needed):
# AGR_LLM_BASE_URL=http://localhost:8000/v1
# AGR_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct

# ── Neo4j ────────────────────────────────────────────────────────────────────
# Bolt, or set NEO4J_HTTP_URL to use the HTTP Query API v2 instead (takes precedence).
NEO4J_URI=bolt://localhost:7687
# NEO4J_HTTP_URL=http://localhost:7474
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=local-dev-password

# ── Qdrant ───────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=local-dev-qdrant-key

# ── MongoDB run_registry (which ingestion run to read) ───────────────────────
# With these set, each connector reads its latest COMPLETED ingestion run, or the
# run a request pins with runIdSuffix. Install the `mongo` extra.
MONGO_URI=mongodb://root:local-dev-password@localhost:27017/?authSource=admin
MONGO_DB=graph_ingestion_checkpoints_dev
# Alternatively pin fixed graphs without MongoDB (JSON list):
# AGR_GRAPH_SOURCES=[{"name":"wikipedia","database":"neo4j","entities_collection":"wiki-entities","chunks_collection":"wiki-chunks"}]

# ── Sources + identity ───────────────────────────────────────────────────────
# AGR_DEFAULT_CONNECTORS=["wikipedia","arxiv"]
# AGR_DEFAULT_TENANT_ID=demo          # tenant used when no x-tenant-id header is sent
# AGR_DEFAULT_PRINCIPALS=["public"]   # principals used when no x-principals header is sent
# ACL_ENFORCEMENT_ENABLED=true        # false = ignore ACLs entirely (dev only)
# AGR_PEOPLE_GRAPH_ENABLED=false      # people/HR tools; needs a connector that writes them

# ── Optional: Redis (shared clarification sessions across replicas) ──────────
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# ── Optional: tracing (install the `tracing` extra) ──────────────────────────
# AGR_TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Optional: service ────────────────────────────────────────────────────────
# AGR_LOG_LEVEL=INFO
# AGR_SERVICE_PORT=5000
# AGR_INTERNAL_AUTH_TOKEN=            # shared secret; callers send x-internal-auth
